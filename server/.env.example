# Apex Cam cloud server — set these in your host's environment (never commit real values).
APEXCAM_SECRET=change-me-to-a-long-random-string   # signs auth tokens
APEXCAM_DECART_KEY=dct_...                          # Decart API key (server-side only)
FLW_SECRET=FLWSECK_...                              # Flutterwave secret key (LIVE for real money)
APEXCAM_PUBLIC_URL=https://api.yourdomain.com       # this server's public URL (payment redirect)
APEXCAM_NGN_PER_USD=1600                            # naira buffer rate
# APEXCAM_DB=apexcam.db                             # SQLite path (default) — use Postgres in prod
